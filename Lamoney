<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Lamoney - Opportunités & Communauté Hacoo</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <style>
    :root {
      --bg: #020617;
      --bg-alt: #050816;
      --card-bg: rgba(10, 10, 25, 0.92);
      --accent: #a855f7;
      --accent-soft: #7c3aed;
      --accent-neon: #e879f9;
      --text-main: #e5e7eb;
      --text-soft: #9ca3af;
      --border: #1f2937;
      --danger: #ef4444;
      --success: #22c55e;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: radial-gradient(circle at top, #111827 0, #020617 40%, #000 100%);
      color: var(--text-main);
      overflow-x: hidden;
    }

    /* ANIMATIONS DE BASE */

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes glowPulse {
      0% { box-shadow: 0 0 12px rgba(168, 85, 247, 0.6); }
      50% { box-shadow: 0 0 24px rgba(232, 121, 249, 0.9); }
      100% { box-shadow: 0 0 12px rgba(168, 85, 247, 0.6); }
    }

    @keyframes neonText {
      0% { text-shadow: 0 0 10px rgba(168, 85, 247, 0.7); }
      50% { text-shadow: 0 0 22px rgba(232, 121, 249, 0.9); }
      100% { text-shadow: 0 0 10px rgba(168, 85, 247, 0.7); }
    }

    section {
      animation: fadeIn 0.9s ease;
    }

    /* HEADER */

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.8rem 2rem;
      background: rgba(5, 6, 20, 0.95);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.8rem;
    }

    .brand-name {
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-size: 0.9rem;
      color: var(--accent-neon);
      animation: neonText 3s infinite alternate;
    }

    .brand-tagline {
      font-size: 0.75rem;
      color: var(--text-soft);
    }

    nav {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    nav a {
      color: var(--text-main);
      text-decoration: none;
      font-size: 0.9rem;
      transition: 0.25s;
      padding: 0.4rem 0.7rem;
      border-radius: 999px;
    }

    nav a:hover {
      color: var(--accent-neon);
      background: rgba(17, 24, 39, 0.9);
      transform: translateY(-2px);
    }

    .menu-toggle {
      display: none;
      border: none;
      background: transparent;
      color: var(--text-main);
      font-size: 1.4rem;
      cursor: pointer;
    }

    .mobile-nav {
      display: none;
      flex-direction: column;
      padding: 0.8rem 2rem 1rem;
      background: rgba(5, 6, 20, 0.98);
      border-bottom: 1px solid var(--border);
    }

    .mobile-nav a {
      color: var(--text-main);
      text-decoration: none;
      padding: 0.5rem 0;
      font-size: 0.95rem;
    }

    .mobile-nav a:hover {
      color: var(--accent-neon);
    }

    /* HERO CYBER SHADOW */

    .hero {
      padding: 4.5rem 2rem 3rem;
      max-width: 1100px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 1.3fr);
      gap: 2.5rem;
      align-items: center;
      position: relative;
    }

    .hero::before {
      content: "";
      position: absolute;
      inset: -100px;
      background:
        radial-gradient(circle at 10% 0%, rgba(168, 85, 247, 0.25), transparent 55%),
        radial-gradient(circle at 90% 100%, rgba(232, 121, 249, 0.18), transparent 55%);
      opacity: 0.7;
      pointer-events: none;
      z-index: -1;
    }

    .hero-left h1 {
      font-size: 2.6rem;
      margin-bottom: 1rem;
      color: var(--accent-neon);
      text-shadow: 0 0 18px rgba(168, 85, 247, 0.8);
      animation: neonText 3s infinite alternate;
    }

    .hero-left p {
      font-size: 1.02rem;
      color: var(--text-soft);
      margin-bottom: 1.8rem;
    }

    .hero-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-bottom: 1.4rem;
    }

    .badge {
      padding: 0.35rem 0.8rem;
      border-radius: 999px;
      border: 1px solid rgba(168, 85, 247, 0.5);
      font-size: 0.75rem;
      color: var(--accent-neon);
      background: rgba(17, 24, 39, 0.9);
    }

    .hero-cta {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      align-items: center;
    }

    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.9rem 1.8rem;
      background: radial-gradient(circle at top, #a855f7, #7c3aed);
      color: #fff;
      border-radius: 999px;
      text-decoration: none;
      font-weight: 600;
      box-shadow: 0 12px 30px rgba(168, 85, 247, 0.7);
      transition: 0.25s;
      animation: glowPulse 3s infinite;
    }

    .btn-primary:hover {
      transform: translateY(-2px) scale(1.03);
    }

    .btn-secondary {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.85rem 1.5rem;
      background: rgba(17, 24, 39, 0.95);
      border-radius: 999px;
      border: 1px solid var(--border);
      color: var(--accent-soft);
      text-decoration: none;
      font-weight: 500;
      transition: 0.25s;
    }

    .btn-secondary:hover {
      border-color: var(--accent-neon);
      box-shadow: 0 0 18px rgba(168, 85, 247, 0.6);
      transform: translateY(-2px);
    }

    .hero-right {
      background: linear-gradient(145deg, rgba(17, 24, 39, 0.98), rgba(15, 23, 42, 0.95));
      border-radius: 24px;
      padding: 1.8rem;
      border: 1px solid var(--border);
      box-shadow: 0 25px 60px rgba(15, 23, 42, 0.9);
      position: relative;
      overflow: hidden;
    }

    .hero-right::before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at top right, rgba(168, 85, 247, 0.25), transparent 60%);
      opacity: 0.7;
      pointer-events: none;
    }

    .hero-right p {
      color: var(--text-soft);
      font-size: 0.95rem;
      margin-bottom: 1rem;
    }

    .levels {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.9rem;
      margin-top: 0.5rem;
    }

    .level-card {
      background: rgba(10, 10, 25, 0.95);
      border-radius: 16px;
      padding: 0.8rem 0.7rem;
      border: 1px solid rgba(55, 65, 81, 0.9);
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .level-card h3 {
      margin: 0;
      font-size: 1rem;
      color: var(--accent-soft);
    }

    .level-card p {
      margin: 0.3rem 0 0;
      font-size: 0.75rem;
      color: var(--text-soft);
    }

    .level-tag {
      position: absolute;
      top: 6px;
      right: 8px;
      font-size: 0.65rem;
      color: var(--accent-neon);
      opacity: 0.8;
    }

    /* SECTIONS GÉNÉRALES */

    .section {
      padding: 3rem 2rem;
      max-width: 1100px;
      margin: 0 auto;
    }

    .section h2 {
      font-size: 1.9rem;
      margin-bottom: 1.5rem;
      text-align: center;
      color: var(--accent-neon);
    }

    .section-subtitle {
      text-align: center;
      color: var(--text-soft);
      font-size: 0.95rem;
      margin-bottom: 2rem;
    }

    .grid-3, .grid-2, .offers, .testimonials {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.5rem;
    }

    .card, .offer-card, .faq-item, .testimonial, .timeline-step {
      background: var(--card-bg);
      backdrop-filter: blur(18px);
      border-radius: 18px;
      padding: 1.6rem;
      border: 1px solid var(--border);
      transition: 0.25s;
      position: relative;
      overflow: hidden;
    }

    .card::before, .offer-card::before, .faq-item::before, .testimonial::before, .timeline-step::before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at top left, rgba(168, 85, 247, 0.18), transparent 55%);
      opacity: 0;
      transition: 0.3s;
      pointer-events: none;
    }

    .card:hover, .offer-card:hover, .faq-item:hover, .testimonial:hover, .timeline-step:hover {
      transform: translateY(-4px);
      border-color: var(--accent-soft);
      box-shadow: 0 18px 40px rgba(15, 23, 42, 0.9);
    }

    .card:hover::before, .offer-card:hover::before, .faq-item:hover::before, .testimonial:hover::before, .timeline-step:hover::before {
      opacity: 1;
    }

    .card h3, .offer-card h3 {
      margin-top: 0;
      color: var(--accent-soft);
      font-size: 1.1rem;
    }

    .card p, .offer-card p, .faq-item p, .testimonial {
      color: var(--text-soft);
      font-size: 0.95rem;
    }

    .offer-card a {
      display: inline-block;
      margin-top: 0.8rem;
      text-decoration: none;
      color: var(--accent-neon);
      font-weight: 600;
      font-size: 0.95rem;
      transition: 0.25s;
    }

    .offer-card a:hover {
      text-shadow: 0 0 12px rgba(168, 85, 247, 0.9);
      transform: translateY(-1px);
    }

    /* TIMELINE */

    .timeline {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    .timeline-step h3 {
      margin-top: 0;
      color: var(--accent-soft);
      font-size: 1rem;
    }

    .timeline-step span {
      font-size: 0.75rem;
      color: var(--accent-neon);
      text-transform: uppercase;
      letter-spacing: 0.12em;
    }

    /* SOCIALS */

    .socials {
      text-align: center;
      margin-top: 2rem;
    }

    .social-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: var(--card-bg);
      padding: 12px 20px;
      margin: 10px;
      border-radius: 999px;
      border: 1px solid var(--border);
      text-decoration: none;
      color: var(--text-main);
      font-weight: 500;
      font-size: 0.9rem;
      transition: 0.25s;
    }

    .social-btn:hover {
      transform: scale(1.07) translateY(-2px);
      border-color: var(--accent-soft);
      box-shadow: 0 0 18px rgba(168, 85, 247, 0.7);
    }

    .social-btn svg {
      width: 20px;
      height: 20px;
      fill: var(--accent-soft);
    }

    /* FOOTER */

    footer {
      padding: 2rem;
      text-align: center;
      font-size: 0.85rem;
      color: #9ca3af;
      background: rgba(5, 6, 20, 0.96);
      backdrop-filter: blur(14px);
      border-top: 1px solid var(--border);
      margin-top: 2rem;
    }

    footer span {
      color: var(--accent-neon);
    }

    /* RESPONSIVE */

    @media (max-width: 900px) {
      .hero {
        grid-template-columns: minmax(0, 1fr);
        text-align: left;
      }
      .hero-right {
        margin-top: 1.5rem;
      }
    }

    @media (max-width: 768px) {
      header {
        padding: 0.7rem 1rem;
      }
      nav {
        display: none;
      }
      .menu-toggle {
        display: block;
      }
      .section {
        padding: 2.5rem 1.4rem;
      }
      .hero {
        padding: 3.5rem 1.4rem 2.5rem;
      }
    }

    @media (max-width: 480px) {
      .hero-left h1 {
        font-size: 2.1rem;
      }
      .hero-cta {
        flex-direction: column;
        align-items: stretch;
      }
      .btn-primary, .btn-secondary {
        justify-content: center;
        width: 100%;
      }
    }
  </style>
</head>

<body>

<header>
  <div class="brand">
    <div>
      <div class="brand-name">LAMONEY</div>
      <div class="brand-tagline">Opportunités • Communauté • Codes exclusifs</div>
    </div>
  </div>
  <nav>
    <a href="#accueil">Accueil</a>
    <a href="#concept">Concept</a>
    <a href="#offres">Offres</a>
    <a href="#code">Code Promo</a>
